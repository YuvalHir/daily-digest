---
const { locale, charts = [] } = Astro.props;
const he = locale === 'he';
const assets = charts.map((chart) => [
  chart.symbol,
  chart.label[locale],
  chart.range,
]);
const ranges = he
  ? [
      ['1h', 'שעה'],
      ['5h', '5 שעות'],
      ['1d', 'יום'],
      ['1mo', 'חודש'],
      ['1y', 'שנה'],
    ]
  : [
      ['1h', '1H'],
      ['5h', '5H'],
      ['1d', '1D'],
      ['1mo', '1M'],
      ['1y', '1Y'],
    ];
---

<section
  class="market-desk"
  data-market-desk
  data-lang={locale}
  data-initial-symbol={assets[0]?.[0] ?? ''}
  data-initial-range={assets[0]?.[2] ?? '1d'}
  data-configured={String(assets.length > 0)}
  aria-labelledby="chart-title"
>
  <div class="chart-heading">
    <h2 id="chart-title">{he ? 'מאחורי הכותרות' : 'Behind the headlines'}</h2>
    <span>{he ? 'תמונת השוק' : 'The market now'}</span>
  </div>
  <div
    class="chart-tabs"
    role="group"
    aria-label={he ? 'בחירת נכס' : 'Select asset'}
  >
    {assets.map(([symbol, label], i) => (
      <button
        type="button"
        data-chart-symbol={symbol}
        data-default-range={assets[i][2]}
        aria-pressed={String(i === 0)}
      >
        <bdi>{label}</bdi>
      </button>
    ))}
  </div>
  <div class="market-instrument">
    <bdi class="market-symbol" data-main-symbol>
      {assets[0]?.[0]?.split(':').at(-1) ?? ''}
    </bdi>
    <bdi data-main-name>{assets[0]?.[1] ?? ''}</bdi>
  </div>
  <div class="native-main-head">
    <strong data-main-price>--</strong>
    <div class="market-daily-change">
      <span data-main-change></span>
      <span class="market-daily-label" data-main-change-label hidden>
        {he ? 'שינוי יומי' : 'Today'}
      </span>
    </div>
  </div>
  <div
    class="native-ranges"
    role="group"
    aria-label={he ? 'טווח זמן' : 'Chart range'}
  >
    {ranges.map(([range, label]) => (
      <button
        type="button"
        data-chart-range={range}
        aria-pressed={String(range === (assets[0]?.[2] ?? '1d'))}
      >
        {label}
      </button>
    ))}
  </div>
  <p class="native-main-range" data-main-range>
    {he ? 'גרף יומי' : 'Daily chart'}
  </p>
  <div
    class="native-main-plot"
    data-main-plot
    tabindex="0"
    role="group"
    aria-label={
      he
        ? 'בדיקת נקודות בגרף: חצים ימינה ושמאלה'
        : 'Inspect chart prices with left and right arrow keys'
    }
  >
    <svg
      viewBox="0 0 840 310"
      preserveAspectRatio="none"
      role="img"
      aria-label={he ? 'גרף מחיר' : 'Price chart'}
      data-main-svg
    ></svg>
    <div class="native-crosshair" data-main-crosshair hidden></div>
    <output data-main-tooltip hidden></output>
    <p data-main-status role="status">
      {he ? 'טוען נתוני שוק…' : 'Loading market data…'}
    </p>
  </div>
  <div class="native-main-axis">
    <span data-main-start></span>
    <span data-main-end></span>
  </div>
  <p class="native-main-stamp" data-main-stamp></p>
  <button
    type="button"
    class="native-cycle"
    data-chart-cycle
    hidden={assets.length < 2}
    aria-pressed="true"
  >
    {he ? 'עצירת החלפה אוטומטית' : 'Pause auto rotation'}
  </button>
  <noscript>
    {he
      ? 'נדרש JavaScript להצגת הגרף. החדשות זמינות גם בלעדיו.'
      : 'JavaScript is needed for the chart. News remains available without it.'}
  </noscript>
</section>
<style>
  .market-instrument {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 10px;
    direction: ltr;
  }
  .market-symbol {
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 5px 8px;
    font: 600 13px var(--mono);
    color: var(--ink);
  }
  [data-main-name] {
    font-size: 16px;
    font-weight: 650;
    color: var(--ink);
  }
  .native-main-head {
    display: flex;
    justify-content: flex-start;
    gap: 16px;
    align-items: center;
    direction: ltr;
    margin: 0 0 20px;
  }
  .native-main-head strong {
    font: 600 clamp(30px, 3vw, 42px) var(--mono);
    letter-spacing: -1.4px;
  }
  .market-daily-change {
    display: grid;
    gap: 1px;
  }
  [data-main-change] {
    font: 600 20px var(--mono);
    white-space: nowrap;
  }
  .market-daily-label {
    font-size: 10px;
    color: var(--muted);
  }
  .native-ranges {
    display: flex;
    gap: 4px;
    direction: ltr;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 8px;
  }
  .native-ranges button {
    min-width: 48px;
    min-height: 36px;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
  }
  .native-ranges button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
    border-radius: 3px;
  }
  .native-main-range {
    font-size: 11px;
    color: var(--muted);
    margin: 13px 0 8px;
  }
  .native-main-plot {
    height: clamp(220px, 30vw, 340px);
    position: relative;
    direction: ltr;
  }
  .native-main-plot svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    touch-action: pan-y;
  }
  .native-main-plot p {
    position: absolute;
    inset: 35% 0 auto;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
  }
  .native-main-plot output {
    position: absolute;
    top: 8px;
    inset-inline-start: 10px;
    background: var(--bg);
    border: 1px solid var(--rule);
    padding: 8px 10px;
    border-radius: 3px;
    font: 11px var(--mono);
    pointer-events: none;
    z-index: 2;
  }
  .native-crosshair {
    position: absolute;
    top: 0;
    bottom: 0;
    border-inline-start: 1px dashed var(--muted);
    pointer-events: none;
  }
  .native-main-axis {
    display: flex;
    justify-content: space-between;
    direction: ltr;
    font: 10px var(--mono);
    color: var(--muted);
    margin-top: 10px;
  }
  .native-main-stamp {
    font-size: 11px;
    color: var(--muted);
    margin: 14px 0 0;
  }
  .market-desk {
    margin-bottom: 30px;
  }
  @media (max-width: 440px) {
    .native-main-head {
      gap: 12px;
    }
    [data-main-change] {
      font-size: 20px;
    }
    .native-ranges button {
      min-width: 44px;
    }
    .native-main-axis {
      font-size: 9px;
    }
  }
</style>
<script>
  import {
    quoteData,
    quoteForDisplay,
    dailyChange,
    flashPrice,
    shortRange,
    quoteStamp,
    cachedQuote,
    localTime,
    rangeText,
    sparkPath,
    type Quote,
  } from '../lib/market-client';
  document
    .querySelectorAll<HTMLElement>('[data-market-desk]')
    .forEach((desk) => {
      const he = desk.dataset.lang === 'he';
      let lastKey = '';
      let displayedSymbol = '';
      if (desk.dataset.configured !== 'true') {
        desk.querySelector('[data-main-status]')!.textContent = he
          ? 'לא נבחר גרף לסיפור המוביל'
          : 'No chart selected for the lead story';
        return;
      }
      let symbol = desk.dataset.initialSymbol!,
        range = desk.dataset.initialRange!,
        version = 0,
        last: Quote | undefined;
      const find = (selector: string) =>
        desk.querySelector<HTMLElement>(selector)!;
      const svg = desk.querySelector<SVGSVGElement>('[data-main-svg]')!,
        status = find('[data-main-status]'),
        tip = find('[data-main-tooltip]'),
        cross = find('[data-main-crosshair]');
      const selectedLabel = () =>
        desk
          .querySelector<HTMLButtonElement>(
            `[data-chart-symbol="${CSS.escape(symbol)}"]`,
          )
          ?.textContent?.trim() || symbol;
      async function render(cacheOnly = false) {
        find('[data-main-name]').textContent = selectedLabel();
        if (displayedSymbol !== symbol) {
          find('[data-main-symbol]').textContent =
            symbol === 'BITSTAMP:BTCUSD'
              ? 'BTC-USD'
              : symbol.split(':').at(-1)!;
          find('[data-main-price]').textContent = '--';
          find('[data-main-change]').textContent = '';
          find('[data-main-change-label]').hidden = true;
          svg.replaceChildren();
          ['[data-main-start]', '[data-main-end]', '[data-main-stamp]'].forEach(
            (x) => (find(x).textContent = ''),
          );
          tip.hidden = true;
          cross.hidden = true;
        }
        const current = ++version;
        status.hidden = false;
        status.textContent = he ? 'טוען נתוני שוק…' : 'Loading market data…';
        try {
          const q = cacheOnly
            ? cachedQuote(symbol, range)
            : await quoteData(symbol, range);
          if (!q) throw Error('No cached quote');
          const display = await quoteForDisplay(symbol, q);
          if (current !== version) return;
          displayedSymbol = symbol;
          last = q;
          lastKey = symbol + range;
          svg.replaceChildren();
          const ns = 'http://www.w3.org/2000/svg',
            min = Math.min(...q.points),
            max = Math.max(...q.points),
            span = max - min || 1;
          const up = q.points.at(-1)! >= q.points[0],
            color = up ? 'var(--rise)' : 'var(--fall)';
          for (let i = 0; i < 4; i++) {
            const y = 10 + i * 90,
              line = document.createElementNS(ns, 'line');
            line.setAttribute('x1', '0');
            line.setAttribute('x2', '840');
            line.setAttribute('y1', String(y));
            line.setAttribute('y2', String(y));
            line.setAttribute('stroke', 'var(--rule)');
            line.setAttribute('stroke-width', '0.6');
            svg.append(line);
            const label = document.createElementNS(ns, 'text');
            label.setAttribute('x', '836');
            label.setAttribute('y', String(y + 14));
            label.setAttribute('text-anchor', 'end');
            label.setAttribute('fill', 'var(--muted)');
            label.setAttribute('font-size', innerWidth < 480 ? '24' : '17');
            label.textContent = (max - (i / 3) * span).toFixed(2);
            svg.append(label);
          }
          const d = sparkPath(q, 840, 290, 10),
            area = document.createElementNS(ns, 'path');
          area.setAttribute('d', d + ' L830,310 L10,310 Z');
          area.setAttribute('fill', color);
          area.setAttribute('opacity', '0.045');
          svg.append(area);
          const path = document.createElementNS(ns, 'path');
          path.setAttribute('d', d);
          path.setAttribute('fill', 'none');
          path.setAttribute('stroke', color);
          path.setAttribute('stroke-width', '2');
          path.setAttribute('vector-effect', 'non-scaling-stroke');
          path.setAttribute('stroke-linecap', 'round');
          path.setAttribute('stroke-linejoin', 'round');
          svg.append(path);
          svg.setAttribute('aria-label', q.name + ' · ' + rangeText(q, he));
          find('[data-main-name]').textContent = selectedLabel();
          find('[data-main-symbol]').textContent = display.symbol;
          find('[data-main-price]').textContent =
            (display.currency === 'USD' && !symbol.startsWith('^') ? '$' : '') +
            display.price.toLocaleString(navigator.language, {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2,
            });
          const change = dailyChange(display);
          find('[data-main-change-label]').hidden = change === null;
          find('[data-main-change]').textContent =
            change === null
              ? ''
              : (change >= 0 ? '+' : '') + change.toFixed(2) + '%';
          find('[data-main-change]').style.color =
            change !== null && change < 0 ? 'var(--fall)' : 'var(--rise)';
          flashPrice(
            find('[data-main-price]'),
            lastPrices.get(symbol),
            display.price,
          );
          lastPrices.set(symbol, display.price);
          find('[data-main-range]').textContent = '';
          find('[data-main-start]').textContent = localTime(q.seriesStart);
          find('[data-main-end]').textContent = localTime(q.seriesAsOf);
          const timing = quoteStamp(display, he);
          find('[data-main-stamp]').textContent =
            shortRange(q, he) +
            ' · ' +
            timing.prefix +
            timing.time +
            timing.suffix;
          desk.dataset.asOf = display.asOf;
          status.hidden = true;
          desk.dataset.stale = String(
            Date.now() - Date.parse(display.asOf) > 1800000,
          );
        } catch {
          if (current !== version) return;
          status.textContent = he
            ? 'הנתונים אינם זמינים כרגע'
            : 'Market data is currently unavailable';
          if (last && lastKey === symbol + range) {
            desk.dataset.stale = 'true';
            status.textContent = he
              ? 'העדכון נכשל. מוצג הציטוט האחרון'
              : 'Refresh failed. Last received quote shown';
          } else {
            svg.replaceChildren();
            find('[data-main-change-label]').hidden = true;
            find('[data-main-price]').textContent = '--';
            [
              '[data-main-change]',
              '[data-main-start]',
              '[data-main-end]',
              '[data-main-stamp]',
            ].forEach((x) => (find(x).textContent = ''));
            find('[data-main-range]').textContent = he
              ? 'אין נתונים לטווח המבוקש'
              : 'No data for the requested range';
            tip.hidden = true;
            cross.hidden = true;
          }
        }
      }
      desk
        .querySelectorAll<HTMLButtonElement>('[data-chart-symbol]')
        .forEach((b) =>
          b.addEventListener('click', () => {
            symbol = b.dataset.chartSymbol!;
            desk
              .querySelectorAll('[data-chart-symbol]')
              .forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            render();
          }),
        );
      desk
        .querySelectorAll<HTMLButtonElement>('[data-chart-range]')
        .forEach((b) =>
          b.addEventListener('click', () => {
            range = b.dataset.chartRange!;
            desk
              .querySelectorAll('[data-chart-range]')
              .forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            render();
          }),
        );
      const plot = find('[data-main-plot]');
      const lastPrices = new Map<string, number>();
      let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cycle = find('[data-chart-cycle]');
      const setPaused = (value: boolean) => {
        paused = value;
        cycle.setAttribute('aria-pressed', String(!paused));
        cycle.textContent = paused
          ? he
            ? 'המשך החלפה'
            : 'Resume rotation'
          : he
            ? 'עצור החלפה'
            : 'Pause rotation';
      };
      setPaused(paused);
      cycle.addEventListener('click', () => setPaused(!paused));
      desk.addEventListener('pointerdown', (event) => {
        if (event.target !== cycle) setPaused(true);
      });
      desk.addEventListener('focusin', (event) => {
        if (event.target !== cycle) setPaused(true);
      });
      const tabs = [
        ...desk.querySelectorAll<HTMLButtonElement>('[data-chart-symbol]'),
      ];
      setInterval(() => {
        if (paused || document.hidden) return;
        const i = tabs.findIndex((x) => x.dataset.chartSymbol === symbol);
        const next = tabs
          .slice(i + 1)
          .concat(tabs.slice(0, i + 1))
          .find((b) => cachedQuote(b.dataset.chartSymbol!, range));
        if (!next || next.dataset.chartSymbol === symbol) return;
        symbol = next.dataset.chartSymbol!;
        tabs.forEach((b) => b.setAttribute('aria-pressed', String(b === next)));
        render(true);
      }, 8000);
      const scrub = (clientX: number) => {
        if (!last || !status.hidden) return;
        const rect = plot.getBoundingClientRect(),
          ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width)),
          index = Math.round(ratio * (last.bars.length - 1)),
          bar = last.bars[index];
        tip.textContent =
          localTime(bar.time) +
          ' · ' +
          bar.value.toLocaleString(navigator.language, {
            maximumFractionDigits: 2,
          });
        tip.hidden = false;
        cross.hidden = false;
        cross.style.left = ratio * 100 + '%';
        plot.dataset.scrubIndex = String(index);
        plot.dataset.scrubValue = String(bar.value);
      };
      plot.addEventListener('keydown', (event) => {
        if (
          !last ||
          !status.hidden ||
          !['ArrowLeft', 'ArrowRight', 'Home', 'End', 'Escape'].includes(
            event.key,
          )
        )
          return;
        event.preventDefault();
        setPaused(true);
        if (event.key === 'Escape') {
          tip.hidden = true;
          cross.hidden = true;
          return;
        }
        let i = Number(plot.dataset.scrubIndex ?? last.bars.length - 1);
        if (event.key === 'Home') i = 0;
        else if (event.key === 'End') i = last.bars.length - 1;
        else
          i = Math.max(
            0,
            Math.min(
              last.bars.length - 1,
              i + (event.key === 'ArrowRight' ? 1 : -1),
            ),
          );
        const box = plot.getBoundingClientRect();
        scrub(box.left + (i / (last.bars.length - 1)) * box.width);
      });
      plot.addEventListener('contextmenu', (event) => event.preventDefault());
      plot.addEventListener('selectstart', (event) => event.preventDefault());
      plot.addEventListener('pointerdown', (event) => {
        setPaused(true);
        plot.setPointerCapture(event.pointerId);
        scrub(event.clientX);
      });
      plot.addEventListener('pointerup', (event) => {
        if (plot.hasPointerCapture(event.pointerId))
          plot.releasePointerCapture(event.pointerId);
      });
      plot.addEventListener('pointercancel', () => {
        tip.hidden = true;
        cross.hidden = true;
      });

      plot.addEventListener('pointermove', (event) => scrub(event.clientX));
      plot.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'touch') return;
        tip.hidden = true;
        cross.hidden = true;
      });
      render();
      setInterval(() => {
        if (!document.hidden) render();
      }, 300000);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) render();
      });
    });
</script>
