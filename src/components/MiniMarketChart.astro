---
const { symbol, locale } = Astro.props;
const he = locale === 'he';
const names: Record<string, string> = {
  'NASDAQ:NVDA': 'Nvidia',
  'NASDAQ:MSFT': 'Microsoft',
  'NASDAQ:AMD': 'AMD',
  'BITSTAMP:BTCUSD': 'Bitcoin',
};
const name = names[symbol];
const delayed = symbol !== 'BITSTAMP:BTCUSD';
---

<section
  class="mini-market"
  data-mini-market
  data-symbol={symbol}
  data-lang={locale}
  aria-label={`${name} ${he ? 'מחיר וגרף עדכניים' : 'current price and chart'}`}
>
  <div class="mini-market-header">
    <bdi>{symbol.split(':')[1]}</bdi>
    <span>{he ? 'ציטוט ספק · חודש אחרון' : 'Provider quote · past month'}</span>
  </div>
  <div class="mini-market-visual" data-mini-visual>
    <p class="mini-loading" role="status">
      {he ? 'טוען מחיר וגרף…' : 'Loading quote and chart…'}
    </p>
  </div>
  <div class="tradingview-widget-copyright">
    <a
      href="https://www.tradingview.com/"
      rel="noopener nofollow"
      target="_blank"
    >
      <span class="blue-text">
        {name} {he ? 'מחיר' : 'price'}
      </span>
    </a>
    <span class="trademark"> by TradingView</span>
  </div>
  <p class="mini-data-note">
    {delayed
      ? he
        ? 'מניה · נתונים מושהים לפי הספק'
        : 'Stock · provider-delayed data'
      : he
        ? 'Bitstamp · פיד בזמן אמת לפי הספק'
        : 'Bitstamp · provider real-time feed'}
  </p>
  <p class="mini-data-time" data-mini-time>
    {he
      ? 'שעת הציטוט לא נמסרה. נפרד מנתוני הדיווח.'
      : 'Quote time not supplied. Separate from report figures.'}
  </p>
  <noscript>
    <p>
      {he
        ? 'המחיר והגרף דורשים JavaScript. הנתונים ההיסטוריים בדיווח אינם משתנים.'
        : 'The quote and chart need JavaScript. Historical figures in the report stay unchanged.'}
    </p>
  </noscript>
</section>
<script>
  const load = (root: HTMLElement) => {
    const host = root.querySelector<HTMLElement>('[data-mini-visual]')!,
      loading = host.querySelector<HTMLElement>('.mini-loading')!;
    const container = document.createElement('div');
    container.className = 'tradingview-widget-container';
    container.style.height = '100%';
    container.style.width = '100%';
    const widget = document.createElement('div');
    widget.className = 'tradingview-widget-container__widget';
    container.append(widget);
    host.append(container);
    const script = document.createElement('script');
    script.async = true;
    script.src =
      'https://s3.tradingview.com/external-embedding/embed-widget-mini-symbol-overview.js';
    script.textContent = JSON.stringify({
      symbol: root.dataset.symbol,
      width: '100%',
      height: '100%',
      locale: root.dataset.lang === 'he' ? 'he_IL' : 'en',
      dateRange: '1M',
      colorTheme: 'dark',
      trendLineColor: 'rgba(230, 166, 108, 1)',
      underLineColor: 'rgba(230, 166, 108, 0.18)',
      underLineBottomColor: 'rgba(230, 166, 108, 0)',
      isTransparent: false,
      autosize: true,
      largeChartUrl: '',
      noTimeScale: true,
      chartOnly: false,
    });
    const fail = () => {
      loading.textContent =
        root.dataset.lang === 'he'
          ? 'המחיר אינו זמין כרגע. אפשר לפתוח את המקור.'
          : 'Quote is unavailable. You can open the source.';
    };
    const timer = setTimeout(fail, 20000);
    const observer = new MutationObserver(() => {
      const frame = container.querySelector('iframe');
      if (frame) {
        frame.addEventListener(
          'load',
          () => {
            loading.remove();
            clearTimeout(timer);
          },
          { once: true },
        );
        observer.disconnect();
      }
    });
    observer.observe(container, { childList: true, subtree: true });
    script.onerror = () => {
      clearTimeout(timer);
      fail();
      observer.disconnect();
    };
    container.append(script);
  };
  const observer = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          observer.unobserve(entry.target);
          load(entry.target as HTMLElement);
        }
      }),
    { rootMargin: '250px' },
  );
  document
    .querySelectorAll<HTMLElement>('[data-mini-market]')
    .forEach((root) => observer.observe(root));
</script>
