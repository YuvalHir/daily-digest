---
import SocialPost from './SocialPost.astro';
import Sparkline from './Sparkline.astro';
import { ui } from '../i18n/ui';
const { item, locale, index = 1, lead = false } = Astro.props;
const t = ui[locale as 'he' | 'en'];
const Heading = lead ? 'h1' : 'h3';
---

<article class:list={['news-card', { 'lead-card': lead }]} id={item.id}>
  <Heading>
    <a href={item.source.url} target="_blank" rel="noopener noreferrer">
      {item.headline[locale]}
    </a>
  </Heading>
  {item.heroImage && (
    <figure>
      <img
        src={item.heroImage.url}
        alt={item.heroImage.caption?.[locale] || ''}
        loading={lead ? 'eager' : 'lazy'}
      />
      <figcaption>
        {item.heroImage.caption?.[locale]}{' '}
        {item.heroImage.credit && <span>© {item.heroImage.credit}</span>}
      </figcaption>
    </figure>
  )}
  <p class="story-summary">{item.summary[locale]}</p>
  {item.bullets && (
    <ul class="story-bullets">
      {item.bullets[locale].map((b) => (
        <li>{b}</li>
      ))}
    </ul>
  )}
  {item.tickers && item.tickers.length > 0 && (
    <div class="story-tickers">
      {item.tickers.map((tick) => (
        <div>
          <bdi dir="ltr">{tick.symbol}</bdi>
          <bdi
            class={tick.changePercent >= 0 ? 'positive' : 'negative'}
            dir="ltr"
          >
            {tick.changePercent >= 0 ? '+' : ''}
            {tick.changePercent.toFixed(2)}%
          </bdi>
          <Sparkline
            series={tick.sparkline}
            positive={tick.changePercent >= 0}
            label={tick.name}
          />
        </div>
      ))}
    </div>
  )}
  {item.socialPost && <SocialPost post={item.socialPost} locale={locale} />}
  {item.marketSymbols?.length > 0 && (
    <div class="related-charts">
      {item.marketSymbols.map((symbol) => (
        <a href="#chart-title" data-open-chart={symbol}>
          <bdi>{symbol.split(':')[1]}</bdi>
          <span>{locale === 'he' ? 'לגרף' : 'Chart'}</span>
        </a>
      ))}
    </div>
  )}
  <footer class="card-footer">
    <div class="source-links">
      <a href={item.source.url} target="_blank" rel="noopener noreferrer">
        {item.source.name}
        <span aria-hidden="true"> ↗</span>
      </a>
      {item.secondarySources?.map((source) => (
        <a href={source.url} target="_blank" rel="noopener noreferrer">
          {source.name} ↗
        </a>
      ))}
    </div>
    <a
      class="read-link"
      href={item.source.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${t.read}: ${item.headline[locale]}`}
    >
      {t.read}
      <span aria-hidden="true"> ↗</span>
    </a>
  </footer>
</article>
