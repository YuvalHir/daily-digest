---
import SocialPost from './SocialPost.astro';
import MoveText from './MoveText.astro';
import { plainMoves } from '../lib/plain-moves';
import NativeQuote from './NativeQuote.astro';
import Sparkline from './Sparkline.astro';
import { ui } from '../i18n/ui';
const { item, locale, index = 1, lead = false } = Astro.props;
const t = ui[locale as 'he' | 'en'];
const Heading = lead ? 'h1' : 'h3';
const marketCharts =
  item.marketCharts ??
  item.marketSymbols?.map((symbol) => ({ symbol, range: '1d' })) ??
  [];
---

<article class:list={['news-card', { 'lead-card': lead }]} id={item.id}>
  <div class="story-kicker">
    <bdi>{String(index).padStart(2, '0')}</bdi>
    <span>{t.sections[item.section]}</span>
  </div>
  <Heading>
    <a href={item.source.url} target="_blank" rel="noopener noreferrer">
      <MoveText text={item.headline[locale]} />
    </a>
  </Heading>
  {item.heroImage && (
    <figure>
      <img
        src={item.heroImage.url}
        alt={item.heroImage.caption?.[locale] || ''}
        loading={lead ? 'eager' : 'lazy'}
      />
      <figcaption>
        {item.heroImage.caption?.[locale]}{' '}
        {item.heroImage.credit && <span>© {item.heroImage.credit}</span>}
      </figcaption>
    </figure>
  )}
  <p class="story-summary">
    <MoveText text={item.summary[locale]} />
  </p>
  {item.bullets && (
    <ul class="story-bullets">
      {item.bullets[locale].map((b) => (
        <li>
          <MoveText text={b} />
        </li>
      ))}
    </ul>
  )}
  {item.tickers && item.tickers.length > 0 && (
    <div class="story-tickers">
      {item.tickers.map((tick) => (
        <div>
          <bdi dir="ltr">{tick.symbol}</bdi>
          <bdi
            class={tick.changePercent >= 0 ? 'positive' : 'negative'}
            dir="ltr"
          >
            {tick.changePercent >= 0 ? '+' : ''}
            {tick.changePercent.toFixed(2)}%
          </bdi>
          <Sparkline
            series={tick.sparkline}
            positive={tick.changePercent >= 0}
            label={tick.name}
          />
        </div>
      ))}
    </div>
  )}
  {item.socialPost && <SocialPost post={item.socialPost} locale={locale} />}
  {marketCharts.length > 0 && (
    <div class="mini-market-grid">
      {marketCharts.map(({ symbol, range }) => (
        <NativeQuote symbol={symbol} range={range} locale={locale} />
      ))}
    </div>
  )}
  <footer class="card-footer">
    <div class="source-links">
      <a href={item.source.url} target="_blank" rel="noopener noreferrer">
        {item.source.name}
        <span aria-hidden="true"> ↗</span>
      </a>
      {item.secondarySources?.map((source) => (
        <a href={source.url} target="_blank" rel="noopener noreferrer">
          {source.name} ↗
        </a>
      ))}
    </div>
    <a
      class="read-link"
      href={item.source.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${t.read}: ${plainMoves(item.headline[locale])}`}
    >
      {t.read}
      <span aria-hidden="true"> ↗</span>
    </a>
  </footer>
</article>
