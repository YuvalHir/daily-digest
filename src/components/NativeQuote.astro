---
const { symbol, locale, size = 'compact', range = '1d' } = Astro.props;
const he = locale === 'he';
---

<div
  class:list={['native-quote', size === 'wide' ? 'wide' : '']}
  data-native-quote
  data-symbol={symbol}
  data-lang={locale}
  data-range={range}
>
  <p class="native-empty">{he ? 'טוען נתוני שוק…' : 'Loading market data…'}</p>
</div>
<style>
  .native-quote {
    --trend: var(--rise, #68d88c);
    display: grid;
    grid-template-columns: minmax(85px, 1fr) minmax(145px, 1.15fr);
    align-items: center;
    gap: 4px 16px;
    background: var(--quote-bg, #111315);
    border: 1px solid var(--quote-rule, #2b3033);
    padding: 12px 14px;
    border-radius: 4px;
    direction: ltr;
    min-width: 0;
  }
  .native-quote.negative {
    --trend: var(--fall, #ef9b91);
  }
  .native-spark {
    height: 38px;
    width: 100%;
    overflow: visible;
  }
  .native-spark path {
    fill: none;
    stroke: var(--trend);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .native-spark circle {
    fill: var(--trend);
  }
  .native-quote-body {
    min-width: 0;
  }
  .native-identity {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    align-items: baseline;
    white-space: nowrap;
  }
  .native-identity bdi {
    font: 600 13px var(--mono, monospace);
    color: var(--ink, #f5f5f2);
  }
  .native-identity span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 12px;
    color: var(--quote-muted, #858c96);
  }
  .native-values {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: 10px;
    margin-block-start: 4px;
    font: 13px var(--mono, monospace);
  }
  .native-values strong {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink, #f0f1f2);
  }
  .native-change {
    color: var(--trend);
    font-weight: 600;
  }
  .native-provenance {
    grid-column: 1;
    grid-row: 2;
    font-size: 10px;
    line-height: 1.5;
    color: var(--quote-muted, #959ca5);
    text-align: start;
    direction: rtl;
    margin-block-start: 3px;
  }
  .native-provenance a {
    color: inherit;
  }
  .native-empty {
    grid-column: 1/-1;
    font-size: 12px;
    color: var(--muted, #b8bbc2);
  }
  .native-quote[data-lang='he'] .native-spark {
    grid-column: 2;
    grid-row: 1;
  }
  .native-quote[data-lang='he'] .native-quote-body {
    grid-column: 1;
    grid-row: 1;
  }
  .native-quote[data-lang='he'] .native-provenance {
    grid-column: 2;
  }
  .wide {
    padding: 16px 18px;
    grid-template-columns: minmax(120px, 1.2fr) minmax(145px, 1fr);
  }
  .wide .native-spark {
    height: 65px;
  }
  .wide .native-values strong {
    font-size: 22px;
  }
  .wide .native-identity bdi {
    font-size: 14px;
  }
  @media (max-width: 450px) {
    .native-quote {
      gap: 4px 12px;
      padding: 11px 12px;
    }
    .wide .native-spark {
      height: 48px;
    }
    .wide .native-values strong {
      font-size: 18px;
    }
  }
</style>
<script>
  import {
    quoteData,
    quoteForDisplay,
    localTime,
    rangeText,
    sparkPath,
    quoteStamp,
    shortRange,
    dailyChange,
    flashPrice,
  } from '../lib/market-client';
  const roots = [
    ...document.querySelectorAll<HTMLElement>('[data-native-quote]'),
  ];
  async function refresh() {
    await Promise.all(
      roots.map(async (root) => {
        const he = root.dataset.lang === 'he';
        try {
          const q = await quoteData(root.dataset.symbol!, root.dataset.range);
          const display = await quoteForDisplay(root.dataset.symbol!, q);
          const scope = [...root.attributes].find((a) =>
            a.name.startsWith('data-astro-cid-'),
          )?.name;
          const el = (tag: string, cls: string, text?: string) => {
            const x = document.createElement(tag);
            if (scope) x.setAttribute(scope, '');
            x.className = cls;
            if (text) x.textContent = text;
            return x;
          };
          const previous = root.dataset.price
            ? Number(root.dataset.price)
            : undefined;
          const change = dailyChange(display);
          root.replaceChildren();
          root.classList.toggle('negative', q.changePercent < 0);
          root.classList.toggle('positive', q.changePercent >= 0);
          const svg = document.createElementNS(
            'http://www.w3.org/2000/svg',
            'svg',
          );
          if (scope) svg.setAttribute(scope, '');
          svg.setAttribute('viewBox', '0 0 164 42');
          svg.setAttribute('class', 'native-spark');
          svg.setAttribute('role', 'img');
          svg.setAttribute('aria-label', rangeText(q, he));
          const path = document.createElementNS(svg.namespaceURI, 'path');
          if (scope) path.setAttribute(scope, '');
          path.setAttribute('d', sparkPath(q, 164, 42));
          svg.append(path);
          root.append(svg);
          const body = el('div', 'native-quote-body'),
            identity = el('div', 'native-identity');
          identity.append(el('bdi', '', q.symbol), el('span', '', q.name));
          const values = el('div', 'native-values');
          values.dir = 'ltr';
          if (change !== null)
            values.append(
              el(
                'span',
                'native-change',
                (change >= 0 ? '+' : '') + change.toFixed(2) + '%',
              ),
            );
          const price = el(
            'strong',
            '',
            (display.currency === 'USD' && !q.symbol.startsWith('^')
              ? '$'
              : '') +
              display.price.toLocaleString(navigator.language, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
              }),
          );
          values.append(price);
          flashPrice(price, previous, display.price);
          root.dataset.price = String(display.price);
          root.classList.toggle('negative', change !== null && change < 0);
          body.append(identity, values);
          root.append(body);
          const stamp = el('div', 'native-provenance');
          stamp.dir = he ? 'rtl' : 'ltr';
          const timing = quoteStamp(display, he);
          stamp.append(
            document.createTextNode(shortRange(q, he) + ' · ' + timing.prefix),
          );
          const time = el('bdi', '', timing.time);
          time.dir = 'ltr';
          stamp.append(time, document.createTextNode(timing.suffix));
          root.append(stamp);
          root.dataset.asOf = display.asOf;
          root.dataset.stale = String(
            Date.now() - Date.parse(display.asOf) > 1800000,
          );
          root.title = he
            ? 'אחוז שינוי מול הסגירה הקודמת, כאשר זמין'
            : 'Change from previous close, when available';
        } catch {
          if (!root.dataset.asOf) {
            root.textContent = he
              ? 'נתוני השוק אינם זמינים כרגע'
              : 'Market data is currently unavailable';
          } else {
            root.dataset.stale = 'true';
            root.title = he
              ? 'העדכון נכשל. מוצג הציטוט האחרון'
              : 'Refresh failed. Last received quote shown';
          }
        }
      }),
    );
  }
  setInterval(
    () =>
      roots.forEach((root) => {
        if (
          root.dataset.asOf &&
          Date.now() - Date.parse(root.dataset.asOf) > 1800000
        )
          root.dataset.stale = 'true';
      }),
    60000,
  );
  refresh();
  setInterval(() => {
    if (!document.hidden) refresh();
  }, 300000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refresh();
  });
</script>
