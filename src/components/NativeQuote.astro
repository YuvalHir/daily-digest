---
/** Presentational only. Connect only to a verified, licensed quote source. */
interface Quote {
  symbol: string;
  name: string;
  price: number;
  currency: string;
  changePercent: number;
  points: number[];
  asOf: string;
  sourceName: string;
  sourceUrl: string;
  status: 'realtime' | 'delayed' | 'closed' | 'stale';
}
interface Props {
  quote?: Quote;
  locale: 'he' | 'en';
  size?: 'compact' | 'wide';
  demo?: boolean;
  symbol?: string;
}
const { quote, locale, size = 'compact', demo = false, symbol } = Astro.props;
const he = locale === 'he';
const valid =
  quote &&
  quote.points.length >= 2 &&
  quote.points.every(Number.isFinite) &&
  Number.isFinite(quote.price) &&
  Number.isFinite(quote.changePercent) &&
  !Number.isNaN(Date.parse(quote.asOf));
const points = valid ? quote.points : [];
const low = Math.min(...points),
  high = Math.max(...points),
  range = high - low || 1;
const path = points
  .map(
    (v, i) =>
      `${i ? 'L' : 'M'}${((i / (points.length - 1)) * 160).toFixed(2)},${(36 - ((v - low) / range) * 30).toFixed(2)}`,
  )
  .join(' ');
const color = quote && quote.changePercent < 0 ? 'negative' : 'positive';
const time = valid
  ? new Intl.DateTimeFormat(he ? 'he-IL' : 'en-GB', {
      timeZone: 'Asia/Jerusalem',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      day: '2-digit',
      month: '2-digit',
    }).format(new Date(quote.asOf))
  : '';
const labels = {
  realtime: he ? 'זמן אמת לפי המקור' : 'Real-time per source',
  delayed: he ? 'מושהה' : 'Delayed',
  closed: he ? 'שוק סגור' : 'Market closed',
  stale: he ? 'לא מעודכן' : 'Stale',
};
---

<div
  data-native-quote
  data-symbol={symbol}
  data-lang={locale}
  class:list={['native-quote', size, color, { 'is-demo': demo }]}
>
  {valid ? (
    <>
      <svg
        class="native-spark"
        viewBox="0 0 164 42"
        preserveAspectRatio="none"
        role="img"
        aria-label={he ? 'מגמת מחיר' : 'Price trend'}
      >
        <path d={path} transform="translate(2 1)" />
        <circle
          cx="162"
          cy={37 - ((points.at(-1)! - low) / range) * 30}
          r="2.8"
        />
      </svg>
      <div class="native-quote-body">
        <div class="native-identity">
          <bdi>{quote.symbol}</bdi>
          <span>{quote.name}</span>
        </div>
        <div class="native-values" dir="ltr">
          <span class="native-change">
            {quote.changePercent >= 0 ? '+' : ''}
            {quote.changePercent.toFixed(2)}%
          </span>
          <strong>
            {quote.currency === 'USD' ? '$' : ''}
            {quote.price.toLocaleString('en-US', {
              maximumFractionDigits: 2,
              minimumFractionDigits: 2,
            })}
          </strong>
        </div>
      </div>
      <div class="native-provenance">
        {demo ? (
          he ? (
            'נתוני דמה לעיצוב בלבד'
          ) : (
            'Synthetic design data only'
          )
        ) : (
          <>
            <a href={quote.sourceUrl} rel="noopener noreferrer" target="_blank">
              {quote.sourceName}
            </a>
            <span>
              {' '}
              · {labels[quote.status]} · <bdi>{time}</bdi>{' '}
              {he ? 'שעון ישראל' : 'Israel time'}
            </span>
          </>
        )}
      </div>
    </>
  ) : (
    <p class="native-empty">
      {he
        ? 'מחיר עדכני לא זמין · לא מוצג מחיר משוער'
        : 'Current quote unavailable · no estimated price shown'}
    </p>
  )}
</div>
<style>
  .native-quote {
    --trend: var(--rise, #68d88c);
    display: grid;
    grid-template-columns: minmax(85px, 1fr) minmax(145px, 1.15fr);
    align-items: center;
    gap: 4px 16px;
    background: var(--quote-bg, #111315);
    border: 1px solid var(--quote-rule, #2b3033);
    padding: 12px 14px;
    border-radius: 4px;
    direction: ltr;
    min-width: 0;
  }
  .native-quote.negative {
    --trend: var(--fall, #ef9b91);
  }
  .native-spark {
    height: 38px;
    width: 100%;
    overflow: visible;
  }
  .native-spark path {
    fill: none;
    stroke: var(--trend);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .native-spark circle {
    fill: var(--trend);
  }
  .native-identity {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    align-items: baseline;
    white-space: nowrap;
  }
  .native-identity bdi {
    font: 600 13px var(--mono, monospace);
    color: var(--ink, #f5f5f2);
  }
  .native-identity span {
    font-size: 12px;
    color: var(--quote-muted, #858c96);
  }
  .native-values {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: 10px;
    margin-block-start: 4px;
    font: 13px var(--mono, monospace);
  }
  .native-values strong {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink, #f0f1f2);
  }
  .native-change {
    color: var(--trend);
    font-weight: 600;
  }
  .native-provenance {
    grid-column: 1/-1;
    font-size: 10px;
    line-height: 1.5;
    color: var(--quote-muted, #959ca5);
    text-align: end;
    direction: rtl;
    margin-block-start: 3px;
  }
  .native-provenance a {
    color: inherit;
  }
  .native-empty {
    grid-column: 1/-1;
    font-size: 12px;
    color: var(--muted, #b8bbc2);
  }
  .wide {
    padding: 16px 18px;
    grid-template-columns: minmax(120px, 1.2fr) minmax(145px, 1fr);
  }
  .wide .native-spark {
    height: 65px;
  }
  .wide .native-values strong {
    font-size: 22px;
  }
  .wide .native-identity bdi {
    font-size: 14px;
  }
  @media (max-width: 450px) {
    .native-quote {
      gap: 4px 12px;
      padding: 11px 12px;
    }
    .wide .native-spark {
      height: 48px;
    }
    .wide .native-values strong {
      font-size: 18px;
    }
  }
</style>

<script>
  const refresh = async () => {
    let data;
    try {
      const response = await fetch(
        'https://raw.githubusercontent.com/YuvalHir/daily-digest/market-data/market.json',
        { cache: 'no-cache' },
      );
      if (!response.ok) throw Error();
      data = await response.json();
    } catch {
      try {
        data = await (
          await fetch('/market.json', { cache: 'no-cache' })
        ).json();
      } catch {
        return;
      }
    }
    document
      .querySelectorAll<HTMLElement>('[data-native-quote]')
      .forEach((root) => {
        const q = data.quotes?.[root.dataset.symbol!],
          he = root.dataset.lang === 'he';
        if (!q || q.unavailable) return;
        const stamp = Date.parse(q.asOf),
          age = (Date.now() - stamp) / 60000;
        if (
          !Number.isFinite(stamp) ||
          !Number.isFinite(q.price) ||
          !Number.isFinite(q.changePercent) ||
          !Array.isArray(q.points) ||
          q.points.length < 2 ||
          !q.points.every(Number.isFinite)
        )
          return;
        const scope = [...root.attributes].find((a) =>
          a.name.startsWith('data-astro-cid-'),
        )?.name;
        const el = (tag: string, cls: string, text?: string) => {
          const x = document.createElement(tag);
          if (scope) x.setAttribute(scope, '');
          x.className = cls;
          if (text) x.textContent = text;
          return x;
        };
        root.replaceChildren();
        root.classList.toggle('negative', q.changePercent < 0);
        root.classList.toggle('positive', q.changePercent >= 0);
        const ns = 'http://www.w3.org/2000/svg',
          svg = document.createElementNS(ns, 'svg');
        if (scope) svg.setAttribute(scope, '');
        svg.setAttribute('class', 'native-spark');
        svg.setAttribute('viewBox', '0 0 164 42');
        svg.setAttribute('preserveAspectRatio', 'none');
        svg.setAttribute('role', 'img');
        svg.setAttribute(
          'aria-label',
          he ? 'מגמת המחיר היום' : 'Today’s price trend',
        );
        const min = Math.min(...q.points),
          range = Math.max(...q.points) - min || 1,
          path = document.createElementNS(ns, 'path');
        if (scope) path.setAttribute(scope, '');
        path.setAttribute(
          'd',
          q.points
            .map(
              (v: number, i: number) =>
                `${i ? 'L' : 'M'}${2 + (i / (q.points.length - 1)) * 160},${37 - ((v - min) / range) * 30}`,
            )
            .join(' '),
        );
        svg.append(path);
        root.append(svg);
        const body = el('div', 'native-quote-body'),
          identity = el('div', 'native-identity');
        identity.append(el('bdi', '', q.symbol), el('span', '', q.name));
        const values = el('div', 'native-values');
        values.dir = 'ltr';
        values.append(
          el(
            'span',
            'native-change',
            (q.changePercent >= 0 ? '+' : '') +
              q.changePercent.toFixed(2) +
              '%',
          ),
          el(
            'strong',
            '',
            (q.currency === 'USD' ? '$' : '') +
              q.price.toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
              }),
          ),
        );
        body.append(identity, values);
        root.append(body);
        const provenance = el('div', 'native-provenance');
        const label =
          q.status === 'closed'
            ? he
              ? 'סגירה'
              : 'Close'
            : age > 30 || q.fetchError
              ? he
                ? 'לא מעודכן'
                : 'Stale'
              : he
                ? 'מטמון · ייתכן עיכוב'
                : 'Cached · may be delayed';
        const time = new Intl.DateTimeFormat(he ? 'he-IL' : 'en-GB', {
          timeZone: 'Asia/Jerusalem',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          day: '2-digit',
          month: '2-digit',
        }).format(new Date(stamp));
        provenance.textContent = `Yahoo Finance · ${label} · ${time} ${he ? 'שעון ישראל · היום' : 'Israel time · 1D'}`;
        root.append(provenance);
        root.dataset.asOf = q.asOf;
      });
  };
  refresh();
  setInterval(() => {
    if (!document.hidden) refresh();
  }, 300000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refresh();
  });
</script>
