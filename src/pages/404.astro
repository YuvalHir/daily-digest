---
import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>404 | הדיילי</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('digest_theme');
        document.documentElement.dataset.theme =
          t === 'light' || t === 'dark'
            ? t
            : matchMedia('(prefers-color-scheme:light)').matches
              ? 'light'
              : 'dark';
      } catch {}
    </script>
  </head>
  <body>
    <main class="error-page">
      <span class="eyebrow">DAILY DIGEST / 404</span>
      <h1>המהדורה לא כאן.</h1>
      <p>הקישור אינו קיים. המהדורה האחרונה מחכה בעמוד הבית.</p>
      <a class="language-toggle" href="/">
        למהדורה האחרונה ↗
      </a>
      <a class="language-toggle" href="/en/" lang="en">
        Latest edition in English ↗
      </a>
    </main>
  </body>
</html>
